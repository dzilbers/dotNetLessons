<Window x:Class="WpfAsyncAwaitExample1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAsyncAwaitExample1"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <StackPanel Margin="20">
        <Button Content="התחל עבודה כבדה" Click="startButton_Click" Padding="10" Margin="0,0,0,20"/>
        <ProgressBar Height="20" Margin="0,0,0,20" IsIndeterminate="{Binding IsLoading}" />
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>
</Window>
